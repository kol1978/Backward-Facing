#!/bin/bash
# search_secrets.sh — поиск и очистка утечек секретов
# Использование: ./search_secrets.sh [путь_к_каталогу] [--full|--cache]
#   --full  — полное сканирование (игнорировать кэш)
#   --cache — сканирование по кэшу (только изменённые файлы)
# Без флагов — интерактивный выбор режима

SEARCH_DIR="."
FORCE_FULL=0
MODE_FLAG=""

for arg in "$@"; do
    if [[ "$arg" == "--full" ]]; then
        FORCE_FULL=1
        MODE_FLAG="set"
    elif [[ "$arg" == "--cache" ]]; then
        FORCE_FULL=0
        MODE_FLAG="set"
    elif [[ "$arg" != -* ]]; then
        SEARCH_DIR="$arg"
    fi
done

# Проверка существования каталога
if [[ ! -d "$SEARCH_DIR" ]]; then
    echo "Ошибка: каталог '$SEARCH_DIR' не существует."
    exit 1
fi

CACHE_FILE="$SEARCH_DIR/.secrets_cache"
HAS_CACHE=0
[[ -f "$CACHE_FILE" ]] && HAS_CACHE=1

# NEW: прогресс только в терминале
if [[ -t 1 ]]; then
    SHOW_PROGRESS=1
else
    SHOW_PROGRESS=0
fi

# --- Интерактивный выбор режима (только если флаг не передан) ---
if [[ -z "$MODE_FLAG" ]]; then
    echo "========================================"
    echo " Режим сканирования"
    echo "========================================"
    echo "  [1] По кэшу (инкрементальный) — только изменённые файлы"
    if [[ $HAS_CACHE -eq 0 ]]; then
        echo "      (кэш отсутствует — будет полное сканирование)"
    fi
    echo "  [2] Полное сканирование — все файлы заново"
    echo ""
    read -p "Выбор [1]: " mode_choice

    if [[ "$mode_choice" == "2" ]]; then
        FORCE_FULL=1
    else
        FORCE_FULL=0
    fi
fi

# FIX: переменная для одинарной кавычки — \x27 не работает в grep -E (ERE)
SQ="'"

# --- Паттерны (ERE-стиль: {N} без обратной косой черты) ---
declare -A PATTERNS=(
    ["Google API Key"]='AIza[0-9A-Za-z_\-]{35}'
    ["AWS Access Key"]='AKIA[0-9A-Z]{16}'
    ["AWS Secret Key"]="aws_secret_access_key[[:space:]]*=[[:space:]]*[\"${SQ}\"][A-Za-z0-9/+=]{40}"
    ["GitHub Token"]='gh[ps]_[0-9A-Za-z]{36}'
    ["GitHub Old Token"]="github_token[[:space:]]*=[[:space:]]*[\"${SQ}\"][0-9a-f]{40}"
    ["Slack Token"]='xox[baprs]-[0-9A-Za-z-]{10,48}'
    ["Stripe Key"]='sk_live_[0-9A-Za-z]{24,99}'
    ["Generic API Key"]="api[_-]?key[[:space:]]*[=:][[:space:]]*[\"${SQ}\"][A-Za-z0-9_\-]{20,}"
    ["Generic Password"]="password[[:space:]]*[=:][[:space:]]*[\"${SQ}\"][^\"${SQ}]{6,}"
    ["Generic Secret"]="secret[[:space:]]*[=:][[:space:]]*[\"${SQ}\"][A-Za-z0-9_\-]{16,}"
    ["Private Key Block"]='BEGIN (RSA |DSA |EC |OPENSSH )?PRIVATE KEY'
    ["Bearer Token"]='Bearer [A-Za-z0-9_\-\.]{20,}'
)

SKIP_EXT_RE='.*\.(png|jpg|jpeg|gif|bmp|svg|pdf|bin|gz|zip|tar|so|o|a|vtk|vtu|vtp|foam|obj|stl)$'

# Объединяем все паттерны в один regex
ALL_PATTERNS=""
for pattern in "${PATTERNS[@]}"; do
    if [[ -z "$ALL_PATTERNS" ]]; then
        ALL_PATTERNS="$pattern"
    else
        ALL_PATTERNS="$ALL_PATTERNS|$pattern"
    fi
done

echo "========================================"
echo " Поиск секретов в: $SEARCH_DIR"
echo " Дата: $(date '+%Y-%m-%d %H:%M:%S')"
if [[ $FORCE_FULL -eq 1 ]]; then
    echo " Режим: ПОЛНОЕ сканирование"
else
    echo " Режим: инкрементальный (по кэшу)"
fi
echo "========================================"
echo ""

# --- Загрузка кэша ---
declare -A CACHED_MTIMES
if [[ $HAS_CACHE -eq 1 && $FORCE_FULL -eq 0 ]]; then
    while IFS='|' read -r mtime fpath; do
        [[ -z "$fpath" ]] && continue
        CACHED_MTIMES["$fpath"]="$mtime"
    done < "$CACHE_FILE"
    echo "Кэш загружен: ${#CACHED_MTIMES[@]} файлов"
elif [[ $FORCE_FULL -eq 1 ]]; then
    echo "Кэш игнорируется (полное сканирование)"
else
    echo "Кэш отсутствует — будет полное сканирование"
fi

# --- Разделение файлов на новые/изменённые и неизменные ---
SCANNED_FILES=()
SKIPPED_COUNT=0
NEW_CACHE_ENTRIES=()

echo "Сбор списка файлов..."
# -regextype должен стоять до -regex (позиционный, влияет на последующие тесты)
ALL_FILES=$(find "$SEARCH_DIR" -regextype posix-extended -type f \
    -not -path "*/.git/*" \
    -not -path "*/.idea/*" \
    -not -path "*/node_modules/*" \
    -not -path "*/__pycache__/*" \
    -not -path "*/0_org/*" \
    -not -path "*/postProcessing/*" \
    -not -path "*/constant/*" \
    -not -path "*/system/*" \
    -not -name ".secrets_cache" \
    -not -regex "$SKIP_EXT_RE" \
    2>/dev/null)

# NEW: подсчёт общего количества файлов для прогресса
if [[ -n "$ALL_FILES" ]]; then
    TOTAL_ALL=$(($(printf '%s\n' "$ALL_FILES" | wc -l)))
else
    TOTAL_ALL=0
fi

FILE_COUNT=0

while IFS= read -r filepath; do
    [[ -z "$filepath" ]] && continue
    FILE_COUNT=$((FILE_COUNT + 1))

    # NEW: прогресс сбора каждые 500 файлов
    if [[ $SHOW_PROGRESS -eq 1 && $((FILE_COUNT % 500)) -eq 0 ]]; then
        printf '\r  Сбор: проверено %d / %d файлов    ' "$FILE_COUNT" "$TOTAL_ALL"
    fi

    current_mtime=$(stat -c %Y "$filepath" 2>/dev/null)
    [[ -z "$current_mtime" ]] && continue

    cached="${CACHED_MTIMES[$filepath]:-}"
    if [[ $FORCE_FULL -eq 0 && -n "$cached" && "$cached" == "$current_mtime" ]]; then
        SKIPPED_COUNT=$((SKIPPED_COUNT + 1))
        NEW_CACHE_ENTRIES+=("$current_mtime|$filepath")
    else
        SCANNED_FILES+=("$filepath")
        NEW_CACHE_ENTRIES+=("$current_mtime|$filepath")
    fi
done <<< "$ALL_FILES"

# NEW: финальная строка прогресса сбора
if [[ $SHOW_PROGRESS -eq 1 ]]; then
    printf '\r  Сбор: проверено %d / %d файлов    \n' "$FILE_COUNT" "$TOTAL_ALL"
fi

TOTAL_FILES=$((${#SCANNED_FILES[@]} + SKIPPED_COUNT))
echo "Всего файлов: $TOTAL_FILES"
echo "Изменено/новых: ${#SCANNED_FILES[@]}"
echo "Пропущено по кэшу: $SKIPPED_COUNT"
echo ""

# --- Сканирование ---
TOTAL_FOUND=0
declare -a FOUND_KEYS
declare -a FOUND_TYPES
declare -a FOUND_LOCATIONS
declare -A UNIQUE_SECRETS

if [[ ${#SCANNED_FILES[@]} -gt 0 ]]; then
    # NEW: пакетный режим для прогресса
    BATCH_SIZE=500
    TOTAL_TO_SCAN=${#SCANNED_FILES[@]}
    SCANNED_COUNT=0
    PROGRESS_PENDING=0

    echo "Сканирование $TOTAL_TO_SCAN файлов..."
    echo ""

    while [[ $SCANNED_COUNT -lt $TOTAL_TO_SCAN ]]; do
        REMAINING=$((TOTAL_TO_SCAN - SCANNED_COUNT))
        [[ $REMAINING -gt $BATCH_SIZE ]] && REMAINING=$BATCH_SIZE

        BATCH=("${SCANNED_FILES[@]:SCANNED_COUNT:REMAINING}")
        SCANNED_COUNT=$((SCANNED_COUNT + REMAINING))

        # NEW: прогресс сканирования
        if [[ $SHOW_PROGRESS -eq 1 ]]; then
            printf '\r  Проверено: %d / %d файлов    ' "$SCANNED_COUNT" "$TOTAL_TO_SCAN"
            PROGRESS_PENDING=1
        fi

        matches=$(grep -nIE "$ALL_PATTERNS" "${BATCH[@]}" /dev/null 2>/dev/null)

        if [[ -n "$matches" ]]; then
            # NEW: завершаем строку прогресса перед выводом совпадений
            if [[ $SHOW_PROGRESS -eq 1 && $PROGRESS_PENDING -eq 1 ]]; then
                echo ""
                PROGRESS_PENDING=0
            fi

            while IFS= read -r line; do
                file=$(printf '%s' "$line" | cut -d: -f1)
                lineno=$(printf '%s' "$line" | cut -d: -f2)
                content_full=$(printf '%s' "$line" | cut -d: -f3-)
                content_short="${content_full:0:120}"

                matched_type="Unknown"
                for name in "${!PATTERNS[@]}"; do
                    if printf '%s' "$content_full" | grep -qE "${PATTERNS[$name]}"; then
                        matched_type="$name"
                        break
                    fi
                done

                if [[ "$matched_type" != "Unknown" ]]; then
                    secret_value=$(printf '%s' "$content_full" | grep -oE "${PATTERNS[$matched_type]}" | head -1)
                else
                    secret_value=""
                fi

                echo ">>> $matched_type"
                echo "   $file:$lineno"
                echo "   → $content_short"
                echo ""

                TOTAL_FOUND=$((TOTAL_FOUND + 1))

                if [[ -n "$secret_value" ]]; then
                    FOUND_KEYS+=("$secret_value")
                    FOUND_TYPES+=("$matched_type")
                    FOUND_LOCATIONS+=("$file:$lineno")
                    UNIQUE_SECRETS["$secret_value"]=1
                fi
            done <<< "$matches"
        fi
    done

    # NEW: завершаем последнюю строку прогресса
    if [[ $SHOW_PROGRESS -eq 1 && $PROGRESS_PENDING -eq 1 ]]; then
        echo ""
    fi
fi

echo "========================================"
if [[ $TOTAL_FOUND -eq 0 ]]; then
    echo " Чисто — секретов не найдено"
else
    echo " Найдено совпадений: $TOTAL_FOUND"
    echo " Уникальных секретов: ${#UNIQUE_SECRETS[@]}"
fi
echo "========================================"

# --- Сохранение кэша ---
if [[ ${#NEW_CACHE_ENTRIES[@]} -gt 0 ]]; then
    printf '%s\n' "${NEW_CACHE_ENTRIES[@]}" > "$CACHE_FILE"
    echo "Кэш сохранён: ${#NEW_CACHE_ENTRIES[@]} файлов"
else
    > "$CACHE_FILE"
    echo "Кэш сохранён (пустой)"
fi

# --- Очистка ---
if [[ $TOTAL_FOUND -eq 0 ]]; then
    exit 0
fi

# Проверка git
if ! git -C "$SEARCH_DIR" rev-parse --git-dir >/dev/null 2>&1; then
    echo ""
    echo "Каталог не является git-репозиторием — очистка невозможна."
    exit 0
fi

if ! command -v git filter-repo &>/dev/null; then
    echo ""
    echo "git filter-repo не установлен."
    echo "Установите: sudo apt install git-filter-repo"
    exit 1
fi

# Меню выбора секретов
echo ""
echo "========================================"
echo " Очистка истории Git"
echo "========================================"
echo ""
echo "Уникальные секреты для замены:"
echo ""

idx=0
declare -a MENU_KEYS
for key in "${!UNIQUE_SECRETS[@]}"; do
    idx=$((idx + 1))
    stype="Unknown"
    sloc=""
    for i in "${!FOUND_KEYS[@]}"; do
        if [[ "${FOUND_KEYS[$i]}" == "$key" ]]; then
            stype="${FOUND_TYPES[$i]}"
            sloc="${FOUND_LOCATIONS[$i]}"
            break
        fi
    done
    echo "  [$idx] $stype"
    echo "      Значение: ${key:0:30}..."
    echo "      Место: $sloc"
    echo ""
    MENU_KEYS[$idx]="$key"
done

echo "  [a] — заменить ВСЕ ($idx шт.)"
echo "  [n] — пропустить очистку"
echo ""
read -p "Выбор: " choice

SELECTED=()

if [[ "$choice" == "a" || "$choice" == "А" || "$choice" == "A" ]]; then
    for key in "${!UNIQUE_SECRETS[@]}"; do
        SELECTED+=("$key")
    done
elif [[ "$choice" =~ ^[0-9]+$ ]] && [[ "$choice" -ge 1 ]] && [[ "$choice" -le $idx ]]; then
    SELECTED+=("${MENU_KEYS[$choice]}")
elif [[ "$choice" == "n" || "$choice" == "N" ]]; then
    echo "Очистка пропущена."
    exit 0
else
    echo "Неверный выбор."
    exit 1
fi

if [[ ${#SELECTED[@]} -eq 0 ]]; then
    echo "Нечего заменять."
    exit 0
fi

# Проверка незакоммиченных изменений
if ! git -C "$SEARCH_DIR" diff --quiet HEAD 2>/dev/null; then
    echo ""
    echo "Внимание: есть незакоммиченные изменения."
    echo "filter-repo может их потерять. Рекомендуется сначала закоммитить."
    read -p "Продолжить? (y/N): " c
    [[ "$c" != "y" && "$c" != "н" ]] && exit 0
fi

# Создание файла замены
REPLACE_FILE=$(mktemp /tmp/replace_XXXXXX.txt)
for key in "${SELECTED[@]}"; do
    echo "${key}==>***REMOVED***" >> "$REPLACE_FILE"
done

echo ""
echo "Будет заменено: ${#SELECTED[@]} секрет(ов)"
echo "Переписать историю Git? Это необратимо."
read -p "Подтвердить? (y/N): " confirm

if [[ "$confirm" != "y" && "$confirm" != "н" ]]; then
    echo "Отменено."
    rm -f "$REPLACE_FILE"
    exit 0
fi

# Запоминаем origin до filter-repo
ORIGIN_URL=$(git -C "$SEARCH_DIR" config --get remote.origin.url 2>/dev/null)

# Запуск filter-repo с проверкой результата
echo ""
echo ">>> Запуск git filter-repo..."
cd "$SEARCH_DIR" || exit 1

if ! git filter-repo --replace-text "$REPLACE_FILE" --force; then
    echo ""
    echo "Ошибка: git filter-repo завершился с ошибкой!"
    echo "История не переписана. Пуш не выполняется."
    rm -f "$REPLACE_FILE"
    if [[ -n "$ORIGIN_URL" ]] && ! git remote get-url origin >/dev/null 2>&1; then
        git remote add origin "$ORIGIN_URL" 2>/dev/null
    fi
    exit 1
fi

rm -f "$REPLACE_FILE"

# Восстановление origin
if [[ -n "$ORIGIN_URL" ]]; then
    if ! git remote get-url origin >/dev/null 2>&1; then
        git remote add origin "$ORIGIN_URL"
    fi
    echo ">>> Push на GitHub..."
    if ! git push --force --all; then
        echo "Предупреждение: push --all завершился с ошибкой."
        echo "Проверьте подключение и права доступа к репозиторию."
    fi
    if ! git push --force --tags; then
        echo "Предупреждение: push --tags завершился с ошибкой."
    fi
    echo ""
    echo "Готово. Секреты заменены на ***REMOVED*** во всей истории."
else
    echo ""
    echo "filter-repo завершился. Origin не был настроен — push пропущен."
    echo "Для отправки выполните:"
    echo "  git remote add origin <URL>"
    echo "  git push --force --all"
    echo "  git push --force --tags"
fi
