FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     foamRun;

solver          fluid;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         0.001;

deltaT          4e-08; // 4e-15; double (стандарт в OpenFOAM) εmach ≈2,22×10^−16

writeControl    runTime;

writeInterval   2e-05;

purgeWrite      0;

writeFormat     ascii;

writePrecision  20;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;
//CFMesh (часто даёт сильно неоднородную/вытянутую сетку)  --- ВКЛЮЧЕНИЕ КОНТРОЛЯ ПО COURANT ---
adjustTimeStep    yes;
maxCo             1.0;
maxDeltaT         1e-3;
// ************************************************************************* //
