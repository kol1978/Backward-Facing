FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "(rho|U|h|p).*"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-015;
        relTol          0.0;
    }
}

PIMPLE
{
    momentumPredictor   yes;
    nOuterCorrectors    2;
    nCorrectors         2;
    nNonOrthogonalCorrectors 1;

    nonOrthogonalityThreshold  60;
    skewnessThreshold          0.5;

    updateEnergyInPISO  false;
    fluxScheme          Kurganov;

    kappaFunction
    {
        type            sonicCourantInverse;

        sonicCourantInverseCoeffs
        {
        }
    }
