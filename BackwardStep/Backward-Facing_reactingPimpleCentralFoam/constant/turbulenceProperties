FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      turbulenceProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
/*
simulationType  laminar;
*/
simulationType   LES;

LES
{
    LESModel        WALE;        // или Smagorinsky, or kEqn
    delta           cubeRootVol; // или smooth

    cubeRootVolCoeffs
    {
        deltaCoeff      1;
    }
}


// ************************************************************************* //
/*
WALE лучше подходит для низкоскоростных течений — корректно восстанавливает асимптотику вблизи стенок и в зонах сдвига. kEqn (one-equation SGS) — альтернатива, если нужна динамическая адаптация вязкости.
 * */
