FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 7.33;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 7.33;
    }
    outlet
    {
        type            zeroGradient;
    }
    walls
    {
        type            kqRWallFunction;
        value           uniform 7.33;
    }
    symwall
    {
        type            empty;
    }
}
// ************************************************************************* //
/*
Интенсивность турбулентности ~1%. Для 44.2 м/с с I = 5%: k=1,5×(0,05×44,2)2 ≈7,33
* */
