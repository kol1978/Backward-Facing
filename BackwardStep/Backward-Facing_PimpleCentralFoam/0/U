FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (44.2 0 0);

boundaryField
{

inlet
{
    type            fixedValue;
    value           uniform (44.2 0 0);   // M = 0.127, T = 300 К,  p = 101325
}
outlet
{
    type            pressureInletOutletVelocity;
    value           uniform (44.2 0 0);
}

    walls
    {
        type            noSlip;
    }
    symwall
    {
        type            empty;
    }
}

