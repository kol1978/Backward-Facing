FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0.6";
    object      alpha.air;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [];

internalField   uniform 1;

boundaryField
{
    inlet
    {
        type            calculated;
        value           uniform 1;
    }
    outlet
    {
        type            calculated;
        value           uniform 1;
    }
    internalFaces
    {
        type            internal;
    }
    walls
    {
        type            calculated;
        value           uniform 1;
    }
}


// ************************************************************************* //
