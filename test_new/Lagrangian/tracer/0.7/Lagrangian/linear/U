FoamFile
{
    format      binary;
    class       LagrangianVectorField;
    location    "0.7/Lagrangian/linear";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0.332089 1.00662 0);

boundaryField
{
    walls
    {
        type            escapeVelocity;
    }
    frontAndBack
    {
        type            empty;
    }
}

sources
{
    pointInjection
    {
        type            NaN;
    }
}


