FoamFile
{
    format      binary;
    class       LagrangianVectorField;
    location    "0.2/Lagrangian/parabolic";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (-0.290738 -0.896538 0);

boundaryField
{
    walls
    {
        type            escapeVelocity;
    }
    frontAndBack
    {
        type            empty;
    }
}

sources
{
    pointInjection
    {
        type            NaN;
    }
}


