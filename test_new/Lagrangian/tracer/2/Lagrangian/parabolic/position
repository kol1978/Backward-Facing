FoamFile
{
    format      binary;
    class       LagrangianVectorField;
    location    "2/Lagrangian/parabolic";
    object      position;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 0 0 0 0 0];

internalField   uniform (-0.000852169 0.400034 -2.77556e-17);

boundaryField
{
    walls
    {
        type            calculated;
    }
    frontAndBack
    {
        type            empty;
    }
}

sources
{
    pointInjection
    {
        type            position;
    }
}


