FoamFile
{
    format      binary;
    class       LagrangianScalarField;
    location    "2.4/Lagrangian/linear";
    object      age;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 1 0 0 0 0];

internalField   uniform 2.4;

boundaryField
{
    walls
    {
        type            calculated;
    }
    frontAndBack
    {
        type            empty;
    }
}

sources
{
    pointInjection
    {
        type            zero;
    }
}


