FoamFile
{
    format      ascii;
    class       LagrangianScalarField;
    location    "0.5/compressibleVoF/Lagrangian/droplets";
    object      m;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 0 0 0 0 0 0];

internalField   uniform 2.15436305288e-09;

boundaryField
{
    bottom
    {
        type            calculated;
    }
    top
    {
        type            calculated;
    }
    defaultFaces
    {
        type            empty;
    }
}

sources
{
    injection
    {
        type            mass;
    }
}


