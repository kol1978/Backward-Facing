FoamFile
{
    format      ascii;
    class       LagrangianVectorField;
    location    "0.7/incompressibleFluid/Lagrangian/droplets";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   nonuniform List<vector> 0();

boundaryField
{
    bottom
    {
        type            escapeVelocity;
    }
    top
    {
        type            escapeVelocity;
    }
    defaultFaces
    {
        type            empty;
    }
}

sources
{
    injection
    {
        type            uniformFixedValue;
        uniformValue    
        {
            type            constant;
            value           (0 0 0);
        }
    }
}


