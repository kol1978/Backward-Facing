FoamFile
{
    format      ascii;
    class       LagrangianScalarField;
    location    "0.7/incompressibleFluid/Lagrangian/droplets";
    object      v;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 3 0 0 0 0 0];

internalField   nonuniform List<scalar> 0();

boundaryField
{
    bottom
    {
        type            calculated;
    }
    top
    {
        type            calculated;
    }
    defaultFaces
    {
        type            empty;
    }
}

sources
{
    injection
    {
        type            volume;
    }
}


