FoamFile
{
    format      ascii;
    class       LagrangianScalarField;
    location    "0.8/compressibleVoF/Lagrangian/droplets";
    object      rho;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -3 0 0 0 0 0];

internalField   nonuniform List<scalar> 0();

boundaryField
{
    bottom
    {
        type            calculated;
    }
    top
    {
        type            calculated;
    }
    defaultFaces
    {
        type            empty;
    }
}

sources
{
    injection
    {
        type            uniformFixedValue;
        uniformValue    
        {
            type            constant;
            value           1000;
        }
    }
}


