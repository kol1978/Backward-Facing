FoamFile
{
    format      ascii;
    class       LagrangianScalarField;
    location    "0.1/compressibleVoF/Lagrangian/droplets";
    object      CrankNicolson:deltaTSp0(U);
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 0 0 0 0 0 0];

internalField   uniform 5.23599e-07;

boundaryField
{
    bottom
    {
        type            calculated;
    }
    top
    {
        type            calculated;
    }
    defaultFaces
    {
        type            empty;
    }
}

sources
{
    injection
    {
        type            NaN;
    }
}


