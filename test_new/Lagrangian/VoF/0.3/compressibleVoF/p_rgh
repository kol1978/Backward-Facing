FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0.3/compressibleVoF";
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 100000;

boundaryField
{
    bottom
    {
        type            fixedFluxPressure;
        gradient        uniform 0;
        value           uniform 100000;
    }
    top
    {
        type            prghTotalPressure;
        rho             rho;
        psi             none;
        gamma           1;
        p0              uniform 100000;
        value           uniform 100000;
        rho             rho;
    }
    defaultFaces
    {
        type            empty;
    }
}


