FoamFile
{
    format      ascii;
    class       LagrangianScalarField;
    location    "0.3/compressibleVoF/Lagrangian/particles";
    object      CrankNicolson:deltaTSp0(U);
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 0 0 0 0 0 0];

internalField   uniform 1.0472e-06;

boundaryField
{
    bottom
    {
        type            calculated;
    }
    top
    {
        type            calculated;
    }
    defaultFaces
    {
        type            empty;
    }
}

sources
{
    injection
    {
        type            NaN;
    }
}


