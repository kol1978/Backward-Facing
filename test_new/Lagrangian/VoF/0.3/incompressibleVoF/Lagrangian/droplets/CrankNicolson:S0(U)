FoamFile
{
    format      ascii;
    class       LagrangianVectorField;
    location    "0.3/incompressibleVoF/Lagrangian/droplets";
    object      CrankNicolson:S0(U);
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 4 -2 0 0 0 0];

internalField   uniform (0 0 2.82912e-09);

boundaryField
{
    bottom
    {
        type            calculated;
    }
    top
    {
        type            calculated;
    }
    defaultFaces
    {
        type            empty;
    }
}

sources
{
    injection
    {
        type            NaN;
    }
}


