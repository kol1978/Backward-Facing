FoamFile
{
    format      ascii;
    class       LagrangianVectorField;
    location    "0.2/incompressibleVoF/Lagrangian/particles";
    object      position;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 0 0 0 0 0];

internalField   uniform (-0.02 2.48506e-19 0.210966);

boundaryField
{
    bottom
    {
        type            calculated;
    }
    top
    {
        type            calculated;
    }
    defaultFaces
    {
        type            empty;
    }
}

sources
{
    injection
    {
        type            position;
    }
}


