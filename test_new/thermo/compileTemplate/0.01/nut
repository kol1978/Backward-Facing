FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0.01";
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0.06497068521;

boundaryField
{
    inlet
    {
        type            calculated;
        value           uniform 0.2597608837;
    }
    outlet
    {
        type            calculated;
        value           uniform 0.06497068521;
    }
    walls
    {
        type            nutkWallFunction;
        Cmu             0.09;
        kappa           0.41;
        E               9.8;
        value           uniform 0.00533312039;
    }
    frontAndBack
    {
        type            empty;
    }
}


