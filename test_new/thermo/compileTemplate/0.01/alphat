FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0.01";
    object      alphat;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -1 0 0 0 0];

internalField   uniform 0.1104099559;

boundaryField
{
    inlet
    {
        type            calculated;
        value           uniform 0.1104099559;
    }
    outlet
    {
        type            calculated;
        value           uniform 0.1104099559;
    }
    walls
    {
        type            compressible::alphatWallFunction;
        Prt             0.85;
        value           uniform 0.007287024613;
    }
    frontAndBack
    {
        type            empty;
    }
}


