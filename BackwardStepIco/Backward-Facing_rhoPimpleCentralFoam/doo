#!/bin/sh
cd "${0%/*}" || exit 1    # Run from this directory

# Source tutorial run functions
. "$WM_PROJECT_DIR/bin/tools/RunFunctions"

# Generate timestamp for log filenames (YYYYMMDD_HHMMSS)
TIMESTAMP=$(date +"%Y%m%d_%H%M%S")

runApplication decomposePar -force > "decomposePar_${TIMESTAMP}.log" 2>&1
runApplication mpirun -np 10 "$(getApplication)" -parallel > "mpirun_${TIMESTAMP}.log" 2>&1
runApplication reconstructPar > "reconstructPar_${TIMESTAMP}.log" 2>&1
