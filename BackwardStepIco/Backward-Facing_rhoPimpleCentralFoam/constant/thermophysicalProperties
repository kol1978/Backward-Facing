FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState perfectGas;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        molWeight       28.96;        // воздух, кг/кмоль
    }
    thermodynamics
    {
        Cp              1004.5;        // Дж/(кг·К)
        Hf              0;
    }
    transport
    {
        mu              1.8e-05;      // Па·с
        Pr              0.71;
    }
}

