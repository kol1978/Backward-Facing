FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     rhoPimpleCentralFoam; //rhoPimpleFoam;

startFrom        latestTime;//startTime;

startTime       0;

stopAt          endTime;

endTime         0.05;

deltaT          1e-7;

writeControl    adjustableRunTime;

writeInterval   0.001;

cycleWrite      0;

writeFormat     ascii;

writePrecision  20;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

adjustTimeStep  true;

//maxCo           0.7;

CourantType     cellCourant;

maxDeltaT       1;
/*
kappaFunction
{
    type            uniformKappaFunction;
    kappa           0;
}*/

kappaFunction
{
    type            standardMachToAcCourantRatio;
    Mmin            0.3;
    Mmax            1.0;
}

