FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application    reactingPimpleCentralFoam;

startFrom       latestTime; //startTime;

startTime       0;

stopAt          endTime;

endTime         10000;

deltaT          1e-5;//2e-05;

writeControl    adjustableRunTime;

writeInterval   250;

cycleWrite      0;

writeFormat     ascii;

writePrecision  20;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

adjustTimeStep  true;

maxCo           0.3;

CourantType     cellCourant;

maxDeltaT       1;

// ************************************************************************* //
