FoamFile
{
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "(p|U|e|h).*"
    {
/*
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-8;
        relTol          0;
*/

        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-8;
        relTol          0;

/*
        solver          GAMG;
	smoother 	symGaussSeidel;
        tolerance       1e-8;
        relTol          0;
*/

	minIter		2;
    }

    "rho.*"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-8;
        relTol          0;
    }
}

PIMPLE
{
    //momentumPredictor 	yes;	//hardwired to yes in OF
    consistent 		yes; 	

    transonic yes;

    nOuterCorrectors     2;		
    nCorrectors          2;		
    nNonOrthogonalCorrectors 1;		

