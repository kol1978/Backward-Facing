FoamFile
{
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     rhoPimpleFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         0.1;

//deltaT          1e-05;
deltaT          1e-03;
//deltaT          5e-04;	//SB OK

writeControl    runTime;

//This option add numerical diffusion
//writeControl    adjustableRunTime;

writeInterval   0.01;

purgeWrite      0;

writeFormat     ascii;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

adjustTimeStep  no;
maxCo           0.5;	
maxDeltaT       0.01;	
//maxDeltaT       0.0005;	

// ************************************************************************* //

functions
{

