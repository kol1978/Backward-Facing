FoamFile
{
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            hePsiThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState perfectGas;
    specie          specie;
    energy          sensibleInternalEnergy;  // e
    // energy          sensibleEnthalpy;       // h
}

mixture
{
    specie
    {
        molWeight       28.97;
        // В оригинале (OF9) был второй блок specie с molWeight 11640.3,
        // который перекрывал первый. Если нужна нестандартная постановка —
        // замените 28.9 на 11640.3.
    }
    thermodynamics
    {
        Cp              1005;
        Hf              0;
    }
    transport
    {
        mu              0;
        Pr              0.7;
    }
}

